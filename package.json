{
  "name": "selvedge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "main-website/*",
    "admin-website/*"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx database/prisma/seed.ts",
    "admin:create": "tsx database/prisma/admin.ts",
    "build": "npm run build --workspaces",
    "verify": "tsx verification/flows.ts",
    "staff:enroll": "tsx database/prisma/enroll.ts"
  },
  "prisma": {
    "schema": "database/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "sharp": "0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/multer": "^2",
    "@types/node": "^24",
    "playwright": "^1.55.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5",
      "deepmerge-ts": "8.0.2"
    }
  }
}
